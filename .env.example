# ============================================================
# Customer Success Automation Hub - 環境變數範例
# ============================================================
# 複製此檔為 .env 後再填入實際數值。.env 不會被 git 追蹤。
# 預設配置可直接在 Windows 11 + PowerShell 本機執行，
# 不需要任何 Microsoft 365 / Azure 帳號。
# ============================================================

# ---------- Backend (FastAPI) ----------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# 預設使用 SQLite，免安裝。
# 若要切換 PostgreSQL（docker-compose 預設提供），改成：
# DATABASE_URL=postgresql+psycopg://csah:csah@db:5432/csah
DATABASE_URL=sqlite:///./app.db

# CORS 允許清單（前端 dev server）
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 是否在啟動時載入展示用 seed 資料（首次 demo 建議 true）
SEED_ON_STARTUP=true

# ---------- AI Assistant ----------
# 預設 mock，不需要任何金鑰即可展示。
# 未來可改為 openai / anthropic / azure_openai。
AI_PROVIDER=mock
AI_MODEL=mock-large
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# ---------- Mock Microsoft Connectors ----------
# 預設 mock 模式：不會打到任何真實 tenant，所有資料保留在本機。
# 若未來要接真實服務，改 mock 為 live 並填入下方 OAuth 設定。
DYNAMICS_CRM_MODE=mock
BUSINESS_CENTRAL_MODE=mock
POWER_AUTOMATE_MODE=mock

# 真實 Dataverse / Dynamics 365 Sales 連線設定（可選）
# DYNAMICS_TENANT_ID=
# DYNAMICS_CLIENT_ID=
# DYNAMICS_CLIENT_SECRET=
# DYNAMICS_RESOURCE_URL=https://yourorg.crm.dynamics.com

# 真實 Business Central 連線設定（可選）
# BC_TENANT_ID=
# BC_ENVIRONMENT=Production
# BC_COMPANY_ID=
# BC_CLIENT_ID=
# BC_CLIENT_SECRET=

# 真實 Power Automate 連線設定（可選）
# POWER_AUTOMATE_FLOW_TRIGGER_URL=

# ---------- Frontend (Vite) ----------
# 注意：前端讀取的環境變數必須以 VITE_ 開頭。
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=Customer Success Automation Hub
